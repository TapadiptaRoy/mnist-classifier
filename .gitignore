# Virtual environment (can be recreated from requirements.txt)
.venv/

# Dataset (downloaded automatically by the code)
data/

# Saved models (large files, recreated by training)
checkpoints/

# Training logs and generated outputs
outputs/

# Python's automatic cache files
__pycache__/
*.pyc

# Jupyter notebook autosaves
.ipynb_checkpoints/

# VS Code personal settings
.vscode/